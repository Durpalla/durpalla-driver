# Copy to .env and fill in. Used by scripts/run_debug.sh and scripts/run_release.sh (not committed).

# Apigw host only (no /api/... path).
# Debug default: https://dev-apigw.durpalla.com
# Release default (run_release.sh): https://apigw.durpalla.com
API_HOST=https://dev-apigw.durpalla.com

# Realtime (optional — empty → FakeRealtimeClient)
PUSHER_KEY=
PUSHER_CLUSTER=ap2

# Bot protection (optional — empty → no-op)
RECAPTCHA_SITE_KEY=

# ABI for physical phones (default in script: arm64-v8a). Smaller = faster wireless install.
ABI=arm64-v8a

# --- Release signing (scripts/generate_keystore.sh fills these) ---
# STORE_FILE=keystore/durpalla-driver-release.jks
# STORE_PASSWORD=
# KEY_ALIAS=durpalla-driver
# KEY_PASSWORD=
